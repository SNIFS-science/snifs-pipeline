#!/bin/bash -l
# Worker job: runs make_parameter_matrix_old for one group of spaxels sequentially.
# Spaxels are processed one at a time; only one spaxel's matrices are live at once.
# Submitted by make_matrix_script.slr — do not submit directly.
#SBATCH --job-name=matrix-worker
#SBATCH --time=12:00:00
#SBATCH --account=cusp
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH -o matrix_worker_%j.out

source /home/anousha/miniconda3/etc/profile.d/conda.sh
conda activate base

# Pick up Prefect server address written by the master job
source "$PREFECT_SERVER_INFO_FILE"
export PREFECT_API_URL

echo "Worker for spaxels ${SPAXEL_RANGE}, connecting to ${PREFECT_API_URL}"

cd /home/anousha/snifs-pipeline
uv run --no-sync python src/pipeline/tasks/processing/make_parameter_matrix.py \
    --spaxels "$SPAXEL_RANGE" \
    --output-dir "$OUTPUT_DIR"
