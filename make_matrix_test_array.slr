#!/bin/bash -l
#
#SBATCH --job-name=matrix-test
#SBATCH --time=01:00:00
#SBATCH -A m112
#SBATCH -C cpu
#SBATCH -q regular
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=113
#SBATCH --ntasks=225
#SBATCH --cpus-per-task=2
#SBATCH -o matrix_test_%j.out

# Ensure uv (installed via `make install_uv` to ~/.local/bin) is on PATH.
export PATH="$HOME/.local/bin:$PATH"

# The work is single-threaded; stop BLAS/OpenMP from spawning idle threads.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

export UV_CACHE_DIR="$PSCRATCH/uv-cache"
mkdir -p "$UV_CACHE_DIR"

# and --ntasks-per-node together (in lockstep) if that ever changes.
# TODO: first spaxel to process (e.g. 135 to start mid-way through the 225).
GROUP_START=0
NUM_SPAXELS=225   # must match --ntasks-per-node above
ITERATION_MAX=4  # trial value; the default full run uses 10

# Override per job to run on different files, e.g.:
#   SCIENCE_IMAGE=/path/to/other.fits OUTPUT_DIR=$SCRATCH/out/other sbatch make_matrix_test_array.slr
SCIENCE_IMAGE="${SCIENCE_IMAGE:-/global/homes/a/anousha/deep_skyflat_coadd.fits}"
OUTPUT_DIR="${OUTPUT_DIR:-$SCRATCH/snifs-pipeline/output/make_matrix_test}"
mkdir -p "$OUTPUT_DIR"

cd $HOME/snifs-pipeline   # TODO: match your actual repo checkout path

# Pre-build the venv so srun steps below don't each try to sync at once.
# Pre-build the venv so srun steps below don't each try to sync at once.
uv sync

# --- Preflight: catch import/syntax errors before launching 225 steps ---
if ! uv run --no-sync python -c "import pipeline.tasks.processing.make_parameter_matrix"; then
    echo "ERROR: import check failed; aborting before launching srun steps." >&2
    exit 1
fi

# --- Prefect server ---
export PREFECT_HOME="/tmp/prefect_server_${USER}_${SLURM_JOB_ID}"
PREFECT_PORT=8100
COMPUTE_NODE=$(hostname)
export PREFECT_API_URL="http://${COMPUTE_NODE}:${PREFECT_PORT}/api"
export PREFECT_UI_API_URL="http://localhost:9999/api"

SERVER_INFO_FILE="${OUTPUT_DIR}/prefect_server_info.env"
echo "PREFECT_API_URL=${PREFECT_API_URL}" > "$SERVER_INFO_FILE"

echo "==========================================================="
echo "Prefect server: ${COMPUTE_NODE}:${PREFECT_PORT}"
echo "To watch the UI:  ssh -L 9999:${COMPUTE_NODE}:${PREFECT_PORT} ${USER}@perlmutter.nersc.gov"
echo "then open:        http://localhost:9999"
echo "==========================================================="

uv run --no-sync prefect server start --host 0.0.0.0 --port $PREFECT_PORT &
SERVER_PID=$!

# Always stop the server, whether we finish normally or abort.
cleanup() {
    kill "$SERVER_PID" 2>/dev/null
    wait "$SERVER_PID" 2>/dev/null
    echo "Prefect server stopped."
}
trap cleanup EXIT

SERVER_UP=0
for i in $(seq 1 60); do
    if curl -s -o /dev/null "http://127.0.0.1:${PREFECT_PORT}/api/health"; then
        echo "Prefect server ready after ${i}s"
        SERVER_UP=1
        break
    fi
    sleep 1
done
if [ "$SERVER_UP" -ne 1 ]; then
    echo "ERROR: Prefect server did not come up within 60s; aborting." >&2
    exit 1
fi

# --- Launch spaxels as concurrent srun steps ---
echo "Launching ${NUM_SPAXELS} spaxels (starting at ${GROUP_START})"

STEP_PIDS=()
for i in $(seq 0 $((NUM_SPAXELS - 1))); do
    SPAXEL=$((GROUP_START + i))
    srun --exclusive -N1 -n1 -c"$SLURM_CPUS_PER_TASK" \
        uv run --no-sync python src/pipeline/tasks/processing/make_parameter_matrix.py \
        --spaxels "$SPAXEL" \
        --iteration-max "$ITERATION_MAX" \
        --science-image "$SCIENCE_IMAGE" \
        --output-dir "$OUTPUT_DIR" &
    STEP_PIDS+=($!)
done

# Wait only on the srun steps (not the server); abort on the first failure.
for pid in "${STEP_PIDS[@]}"; do
    if ! wait "$pid"; then
        echo "ERROR: an srun step (pid $pid) failed; killing remaining steps." >&2
        kill "${STEP_PIDS[@]}" 2>/dev/null
        wait "${STEP_PIDS[@]}" 2>/dev/null
        sacct -j "$SLURM_JOB_ID" --format=JobID,Elapsed,MaxRSS,State | head -20
        exit 1
    fi
done

echo "All ${NUM_SPAXELS} spaxels finished"
sacct -j "$SLURM_JOB_ID" --format=JobID,Elapsed,MaxRSS,State | head -20